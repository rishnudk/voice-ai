# Cloudflare Workers AI — used for Whisper audio transcription
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Google AI Studio — used for Gemini semantic concept analysis
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional: xAI — used for Grok semantic analysis fallback
# XAI_API_KEY=your_xai_key_here

# Set to "true" to use mock AI responses (no real API calls)
MOCK_AI=true
